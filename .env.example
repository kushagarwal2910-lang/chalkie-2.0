# Required for live Chalkie intelligence, speech-to-text, and server TTS
GROQ_API_KEY=
# Optional sticky failover keys. Chalkie only switches when the active key is
# rate-limited or rejected; it does not round-robin healthy requests.
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Optional persistent directory for repository snapshots (7-day retention).
# Required on ephemeral hosts; use a private writable mounted volume.
CHALKIE_DATA_DIR=

# Optional model overrides for Groq's pre-available audio models
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Optional: browser speech synthesis is used by default. Set true to request
# Groq Orpheus audio from /api/speech instead.
NEXT_PUBLIC_USE_GROQ_TTS=false

# Optional Google Drive backup. SESSION_SECRET must be 32+ random characters.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# Required in production when users can save BYOK credentials. Use a separate
# random value of at least 32 characters. Local development uses a checkout-local
# secret file when this is omitted.
BYOK_ENCRYPTION_SECRET=
